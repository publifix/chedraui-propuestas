# Copiar a .env y llenar localmente. Los valores reales nunca van en el código.
# En GitHub Actions se cargan desde los secrets del repositorio.

# Tracking (paso 9). Clave publishable; RLS solo permite insertar.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ruta del contenido (plazas, locales, presentaciones). Ver CLAUDE.md §16.
CONTENT_DIR=content
