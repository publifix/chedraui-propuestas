---
// Una idea por pantalla: cada sección del visor (paso 5) se monta dentro de un Screen.
interface Props {
  /** Identificador estable (src/lib/sections.ts) para data-section y el tracking del paso 9. */
  section?: string
  labelledby?: string
  align?: 'start' | 'center'
  /** brand: sección a sangre en el color de marca de la plaza. */
  tone?: 'default' | 'brand'
  /** Sin márgenes laterales ni ancho máximo, para imágenes a sangre. */
  bleed?: boolean
  /** Sin alto mínimo de pantalla, para bloques que siguen a otra pantalla. */
  compact?: boolean
}

const { section, labelledby, align = 'center', tone = 'default', bleed = false, compact = false } = Astro.props
---
<section class:list={['screen', `screen--${align}`, tone === 'brand' && 'surface-brand', bleed && 'screen--bleed', compact && 'screen--compact']} data-section={section} aria-labelledby={labelledby}>
  <div class="screen__inner" data-reveal>
    <slot />
  </div>
</section>

<style>
  .screen {
    display: grid;
    min-block-size: calc(100svh - var(--chrome-h));
    padding-block: var(--space-2xl);
    padding-inline: max(var(--space-m), env(safe-area-inset-left)) max(var(--space-m), env(safe-area-inset-right));
    border-block-end: var(--line-width) solid var(--color-line);
  }

  .screen--center {
    align-items: center;
  }

  .screen--start {
    align-items: start;
  }

  .screen--bleed {
    padding-inline: 0;
    padding-block: 0;
  }

  .screen--bleed .screen__inner {
    max-inline-size: none;
  }

  .screen--compact {
    min-block-size: 0;
  }

  .screen__inner {
    /* Un titular o una palabra larga nunca ensancha la pantalla más allá del viewport. */
    min-inline-size: 0;
    inline-size: 100%;
    max-inline-size: 72rem;
    margin-inline: auto;
  }
</style>
