---
// Secuencia de lo macro a lo micro: región → plaza → planta → local. Sin JavaScript o con
// movimiento reducido se ve como cuadros estáticos; con movimiento, GSAP + ScrollTrigger la
// convierten en una sola escena ligada al scroll (transform y opacity, nada más).
import Label from '../Label.astro'
import type { ResolvedFloorPlan, ResolvedPresentation } from '../../lib/resolve'
import { frameAround, prepareSvg } from '../../lib/plano/svg'

interface Props {
  model: ResolvedPresentation
  plan: ResolvedFloorPlan
}

const { model, plan } = Astro.props
const { plaza } = model
const vb = plan.info.viewBox
const clave = plan.claves[0]!
const target = plan.info.locales.get(clave)!
const local = model.locales.find((l) => l.clave === clave)!
const marca = Object.fromEntries(plan.claves.map((c) => [c, { class: 'is-target' }]))
const etiqueta = Object.fromEntries(plan.claves.map((c) => [c, { class: 'is-target-label' }]))
const foco = frameAround(target.bbox, vb, { width: 360, ratio: vb.width / vb.height })
const pct = (v: number, start: number, size: number) => +(((v - start) / size) * 100).toFixed(2)

const frames = [
  ...(model.region
    ? [{
        id: 'region',
        svg: prepareSvg(model.region.svg, { prefix: 'zr-' }),
        titulo: plaza.ubicacion.zona,
        texto: `${plaza.ubicacion.ciudad}, ${plaza.ubicacion.estado} · mapa ilustrativo, no a escala`,
        alt: `Mapa ilustrativo de ${plaza.ubicacion.ciudad} con la ubicación de ${plaza.nombre}`,
        ratio: model.region.info.viewBox.width / model.region.info.viewBox.height,
        origin: `${pct(model.region.info.plaza.cx, model.region.info.viewBox.x, model.region.info.viewBox.width)}% ${pct(model.region.info.plaza.cy, model.region.info.viewBox.y, model.region.info.viewBox.height)}%`,
      }]
    : []),
  {
    id: 'plaza',
    svg: prepareSvg(plan.svg, { prefix: 'zp-' }),
    titulo: plaza.nombre_completo ?? plaza.nombre,
    texto: 'Anclas, estacionamiento y marina · plano esquemático, no a escala',
    alt: `Silueta de ${plaza.nombre} con sus anclas, estacionamiento y marina`,
    ratio: vb.width / vb.height,
  },
  {
    id: 'planta',
    svg: prepareSvg(plan.svg, { prefix: 'zn-', locales: marca, labels: etiqueta }),
    titulo: plan.nivel.nombre,
    texto: `${plan.info.locales.size} locales · plano esquemático, no a escala`,
    alt: `${plan.nivel.nombre} de ${plaza.nombre} con el local ${clave} resaltado`,
    ratio: vb.width / vb.height,
    origin: `${pct(target.bbox.x + target.bbox.width / 2, vb.x, vb.width)}% ${pct(target.bbox.y + target.bbox.height / 2, vb.y, vb.height)}%`,
    scale: +(vb.width / foco.width).toFixed(3),
    shift: `${+(50 - pct(target.bbox.x + target.bbox.width / 2, vb.x, vb.width)).toFixed(2)} ${+(50 - pct(target.bbox.y + target.bbox.height / 2, vb.y, vb.height)).toFixed(2)}`,
  },
  {
    id: 'local',
    svg: prepareSvg(plan.svg, { prefix: 'zl-', locales: marca, labels: etiqueta, viewBox: foco }),
    titulo: `Local ${clave}`,
    texto: `${local.area_m2.toLocaleString('es-MX')} m² · ${plan.nivel.nombre}`,
    alt: `Acercamiento al local ${clave} y sus vecinos`,
    ratio: foco.width / foco.height,
  },
]
---
<div class="zoom" data-zoom>
  <div class="zoom__stage">
    {frames.map((f, i) => (
      <figure class:list={['zoom__frame', `zoom__frame--${f.id}`]} data-frame={f.id} data-origin={f.origin} data-scale={f.scale} data-shift={f.shift} style={`--ratio:${f.ratio.toFixed(4)}`}>
        <div class="zoom__art" role="img" aria-label={f.alt} set:html={f.svg} />
        <figcaption class="zoom__caption">
          <span class="zoom__paso t-meta tabular" aria-hidden="true">{i + 1}/{frames.length}</span>
          <Label as="span" text={f.titulo} />
          <span class="t-meta">{f.texto}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<script>
  // Solo con movimiento permitido se carga GSAP (chunk aparte, servido desde el sitio).
  const root = document.querySelector<HTMLElement>('[data-zoom]')
  const allowMotion = matchMedia('(prefers-reduced-motion: no-preference)').matches
  if (root && allowMotion) {
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger)
      const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')]
      const art = (f: HTMLElement) => f.querySelector<SVGElement>('svg')!
      const box = (f: HTMLElement) => f.querySelector<HTMLElement>('.zoom__art')!
      const caption = (f: HTMLElement) => f.querySelector<HTMLElement>('.zoom__caption')!
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--chrome-h')) || 0
      root.classList.add('is-animated')
      gsap.set(frames.slice(1).flatMap((f) => [box(f), caption(f)]), { autoAlpha: 0 })

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: root,
          start: () => `top top+=${document.querySelector<HTMLElement>('.chrome')?.offsetHeight ?? header}`,
          end: () => `+=${window.innerHeight * frames.length * 0.9}`,
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
        },
      })
      frames.forEach((frame, i) => {
        const next = frames[i + 1]
        if (!next) return
        const { origin = '50% 50%', scale, shift } = frame.dataset
        if (frame.dataset.frame === 'region') {
          tl.to(art(frame), { scale: 5, transformOrigin: origin, duration: 1 })
        } else if (scale && shift) {
          const [x = 0, y = 0] = shift.split(' ').map(Number)
          tl.to(art(frame), { scale: Number(scale), xPercent: x, yPercent: y, transformOrigin: origin, duration: 1 })
        } else {
          tl.to({}, { duration: 0.6 })
        }
        // Las imágenes se funden a la vez; los textos, uno después del otro para no encimarse.
        tl.to(box(frame), { autoAlpha: 0, duration: 0.35 }, '>-0.35')
        tl.to(box(next), { autoAlpha: 1, duration: 0.35 }, '<')
        tl.to(caption(frame), { autoAlpha: 0, duration: 0.15 }, '<')
        tl.to(caption(next), { autoAlpha: 1, duration: 0.2 }, '>')
      })
      tl.to({}, { duration: 0.4 })
    })
  }
</script>

<style>
  .zoom__stage {
    display: grid;
    gap: var(--space-xl);
  }

  .zoom__frame {
    display: grid;
    gap: var(--space-s);
  }

  .zoom__art {
    overflow: hidden;
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-bg);
  }

  .zoom__art :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .zoom__caption {
    display: grid;
    gap: var(--space-3xs);
  }

  .zoom__paso {
    color: var(--color-accent);
  }

  /* Vista de plaza: solo silueta, anclas, estacionamiento y marina. */
  .zoom__frame--plaza :global([data-capa='locales']),
  .zoom__frame--plaza :global([data-capa='pasillos']),
  .zoom__frame--plaza :global([data-capa='accesos']),
  .zoom__frame--plaza :global([data-capa='rutas']) {
    display: none;
  }

  /* En las vistas de conjunto los rótulos crecen para leerse a 360 px y la leyenda va en el pie. */
  .zoom__frame--plaza :global([data-capa='etiquetas'] text),
  .zoom__frame--planta :global([data-capa='etiquetas'] text) {
    font-size: 46px;
  }

  .zoom__frame--plaza :global([data-capa='etiquetas'] text[data-leyenda]),
  .zoom__frame--planta :global([data-capa='etiquetas'] text[data-leyenda]) {
    display: none;
  }

  /* En las vistas de conjunto solo se rotulan anclas, estacionamiento y marina. */
  .zoom__frame--plaza :global([data-capa='etiquetas'] text[data-para]:not([data-para^='ancla']):not([data-para^='estacionamiento']):not([data-para='marina'])),
  .zoom__frame--planta :global([data-capa='etiquetas'] text[data-para]:not([data-para^='ancla']):not([data-para^='estacionamiento']):not([data-para='marina'])) {
    display: none;
  }

  /* Escena animada: los cuadros se apilan en una sola pantalla fija mientras dura el scroll. */
  .zoom.is-animated .zoom__stage {
    display: grid;
    grid-template-areas: 'frame';
    align-items: center;
    block-size: calc(100svh - var(--chrome-h));
    padding-block: var(--space-m);
  }

  .zoom.is-animated .zoom__frame {
    grid-area: frame;
    align-content: center;
    will-change: opacity;
  }

  .zoom.is-animated .zoom__art {
    overflow: hidden;
    contain: paint;
  }

  .zoom.is-animated .zoom__art :global(svg) {
    will-change: transform;
    inline-size: min(100%, calc((100svh - var(--chrome-h) - 10rem) * var(--ratio)));
    margin-inline: auto;
  }
</style>
