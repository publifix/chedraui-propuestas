---
// Plano interactivo de un nivel. Abre con la planta completa y el local marcado ("Tu local"),
// con acercamiento animado a su zona; panel al tocar un local; capas que se resaltan con
// botones de activar y desactivar; ruta desde el estacionamiento o un ancla; versión en texto.
// Los rótulos se pintan en HTML sobre el SVG, desde la configuración y la geometría del plano (el
// SVG no trae textos): anclas, estacionamientos y marina siempre; claves de locales al acercar.
import Field from '../Field.astro'
import Label from '../Label.astro'
import { ocupantesDe, vecinosDe, type ResolvedFloorPlan, type ResolvedPresentation } from '../../lib/resolve'
import { esGiroAfin } from '../../lib/plano/afines'
import { frameAround, prepareSvg } from '../../lib/plano/svg'
import { isTodo } from '../../lib/todo'

interface Props {
  model: ResolvedPresentation
  plan: ResolvedFloorPlan
  kind: 'revision' | 'envio'
}

const { model, plan, kind } = Astro.props
const { plaza, giro } = model
const afines = giro.giros_afines ?? []
const ocupantes = ocupantesDe(model, plan.nivel.id)
const vb = plan.info.viewBox
const clave = plan.claves[0]!
const local = model.locales.find((l) => l.clave === clave)!
const vecinos = vecinosDe(model, local)
const sinDato = kind === 'revision' ? 'pendiente' : 'sin información'
const texto = (v: string | undefined) => (v === undefined || isTodo(v) ? sinDato : v)

// Datos del panel por clave: ocupantes del nivel y locales de la presentación.
type Info = { clave: string; marca: string; giro: string; area?: string; estado?: string; objetivo?: boolean; afin?: boolean }
const info: Record<string, Info> = {}
for (const o of ocupantes) {
  info[o.clave] = {
    clave: o.clave,
    marca: texto(o.marca),
    giro: texto(o.giro),
    ...(o.area_m2 && { area: `${o.area_m2.toLocaleString('es-MX')} m²` }),
    ...(esGiroAfin(o.giro, afines) && { afin: true }),
  }
}
for (const l of model.locales.filter((l) => plan.claves.includes(l.clave))) {
  info[l.clave] = { clave: l.clave, marca: `Local para ${model.prospecto.marca}`, giro: l.estado === 'disponible' ? 'Disponible' : 'Apartado', area: `${l.area_m2.toLocaleString('es-MX')} m²`, objetivo: true }
}
const categorias = new Map(ocupantes.map((o) => [o.clave, o.categoria ?? 'tienda']))
const attrs = Object.fromEntries(
  [...plan.info.locales.keys()].map((c) => {
    const i = info[c]
    const a: Record<string, string> = {
      tabindex: '0',
      role: 'button',
      'aria-pressed': 'false',
      'aria-label': i ? `Local ${c}: ${i.marca}, ${i.giro}` : `Local ${c}`,
      'data-categoria': categorias.get(c) ?? 'tienda',
    }
    if (i?.afin) a['data-afin'] = ''
    if (i?.objetivo) a['class'] = 'is-target'
    return [c, a]
  }),
)
// Rótulos: anclas (marca), estacionamientos y marina siempre; claves de los locales al acercar.
type Rotulo = { texto: string; x: number; y: number; tipo: 'lugar' | 'local' | 'objetivo' }
const rotulos: Rotulo[] = [
  ...plan.info.anclas.flatMap((a) => (a.punto ? [{ texto: a.marca, ...a.punto, tipo: 'lugar' as const }] : [])),
  ...plan.info.estacionamientos.flatMap((e) => (e.punto ? [{ texto: 'Estacionamiento', ...e.punto, tipo: 'lugar' as const }] : [])),
  ...plan.info.marina.map((m) => ({ texto: m.nombre, ...m.punto, tipo: 'lugar' as const })),
  ...[...plan.info.locales].map(([c, l]) => ({ texto: c, ...l.punto, tipo: plan.claves.includes(c) ? ('objetivo' as const) : ('local' as const) })),
]
// Acercamiento con la misma proporción que la planta: el mapa no cambia de alto al animarse.
const bboxLocal = plan.info.locales.get(clave)!.bbox
const detalle = frameAround(bboxLocal, vb, { width: 560, ratio: vb.width / vb.height })
const svg = prepareSvg(plan.svg, { prefix: 'pi-', locales: attrs })
const view = (v: typeof vb) => `${v.x} ${v.y} ${v.width} ${v.height}`
/** Posición en % dentro de la vista inicial (planta completa); el script la recalcula al acercar. */
const pct = (x: number, y: number) => ({ left: ((x - vb.x) / vb.width) * 100, top: ((y - vb.y) / vb.height) * 100 })
const pos = (x: number, y: number) => `left:${pct(x, y).left.toFixed(2)}%;top:${pct(x, y).top.toFixed(2)}%`
/** Cerca de un borde, el rótulo se alinea hacia dentro para no cortarse. */
const borde = (left: number) => (left < 12 ? 'inicio' : left > 88 ? 'fin' : undefined)
const centro = plan.info.locales.get(clave)!.punto

const ruta = local.ruta && plan.info.rutas.find((r) => r.desde === local.ruta!.desde && r.hasta === clave)
const origen = ruta && plan.info.origenes.get(ruta.desde)
const restaurantes = ocupantes.filter((o) => o.categoria === 'restaurante').length
const nAfines = ocupantes.filter((o) => esGiroAfin(o.giro, afines)).length
const capas = [
  { id: 'anclas', nombre: 'Anclas', n: plan.info.anclas.length },
  { id: 'restaurantes', nombre: 'Restaurantes', n: restaurantes },
  { id: 'accesos', nombre: 'Accesos', n: plan.info.accesos.length },
  { id: 'estacionamiento', nombre: 'Estacionamiento', n: plan.info.estacionamientos.length },
  ...(afines.length > 0 ? [{ id: 'afines', nombre: `Afines a ${giro.nombre.toLowerCase()}`, n: nAfines }] : []),
].filter((c) => c.n > 0)
const id = `plano-${plan.nivel.id.toLowerCase()}`
---
<div class="plano" id={id} data-plano data-view-detalle={view(detalle)} data-view-completo={view(vb)}>
  <div class="plano__lienzo">
    <div class="plano__mapa" data-mapa>
      <div class="plano__svg" role="group" aria-label={`Plano esquemático de ${plan.nivel.nombre.toLowerCase()} con el local ${clave} marcado. Toca un local para ver quién lo ocupa.`} set:html={svg} />
      <div class="plano__rotulos" aria-hidden="true">
        {rotulos.map((r) => <span class:list={['rotulo', `rotulo--${r.tipo}`]} data-x={r.x} data-y={r.y} data-borde={r.tipo === 'lugar' ? borde(pct(r.x, r.y).left) : undefined} style={pos(r.x, r.y)}>{r.texto}</span>)}
        <span class="marcador" data-x={centro.x} data-y={centro.y} data-abajo={pct(centro.x, centro.y).top < 40 ? '' : undefined} style={pos(centro.x, centro.y)}>
          <span class="marcador__anillo"></span>
          <span class="marcador__etiqueta">Tu local · {clave}</span>
        </span>
      </div>
    </div>

    <!-- En escritorio, en la esquina del plano; en celular, debajo, para no taparlo. -->
    <div class="plano__zoom" role="group" aria-label="Acercar o alejar el plano">
      <button type="button" class="zoom__boton" data-zoom="mas" aria-label="Acercar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6v12M6 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <button type="button" class="zoom__boton" data-zoom="menos" aria-label="Alejar" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>

    <!-- Ficha del local tocado: flota junto al local, dentro de la pantalla. -->
    <div class="plano__ficha" data-ficha hidden>
      <div class="ficha__cuerpo" aria-live="polite">
        <p class="ficha__clave t-label" data-ficha-clave></p>
        <p class="ficha__marca" data-ficha-marca></p>
        <p class="ficha__giro t-meta" data-ficha-giro></p>
      </div>
      <button type="button" class="ficha__cerrar" data-ficha-cerrar aria-label="Cerrar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="plano__barra">
    <p class="plano__ayuda t-meta">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3.5" fill="currentColor" /><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <span>Toca un local para ver quién lo ocupa. Acerca con + y −, o pellizcando con dos dedos en la pantalla o el pad; arrastra para moverte.</span>
    </p>
    <div class="plano__vistas">
      <button type="button" class="plano__vista" data-ir="detalle">
        <svg class="vista__icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        Ir a tu local
      </button>
      <button type="button" class="plano__vista" data-ir="completo">
        <svg class="vista__icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Ver la plaza completa
      </button>
    </div>
  </div>

  <fieldset class="plano__capas">
    <legend><Label as="span" text="Resalta en el plano" /></legend>
    <p class="capas__ayuda t-meta">Toca un botón para activarlo; vuelve a tocarlo para quitarlo. Puedes combinarlos.</p>
    <div class="capas__lista">
      {capas.map((c) => (
        <button type="button" class:list={['capa', `capa--${c.id}`]} aria-pressed="false" data-capa-toggle={c.id}>
          <span class="capa__muestra" aria-hidden="true"></span>
          <span class="capa__nombre">{c.nombre}</span>
          <span class="capa__n tabular" aria-label={`${c.n} en el plano`}>{c.n}</span>
        </button>
      ))}
      {ruta && (
        <button type="button" class="capa capa--ruta" aria-pressed="false" data-ruta-toggle={ruta.id}>
          <span class="capa__muestra" aria-hidden="true"></span>
          <span class="capa__nombre">Ruta desde {origen?.toLowerCase()}</span>
        </button>
      )}
    </div>
  </fieldset>

  {ruta && (
    <p class="plano__ruta" data-ruta-texto hidden>
      <strong>Desde {origen?.toLowerCase()}:</strong> <Field value={local.ruta!.texto} />
    </p>
  )}

  <details class="plano__texto desplegable">
    <summary>Ver el plano en texto</summary>
    <div class="texto__grid">
      <section>
        <h3 class="t-label">Tu local</h3>
        <p>Local {clave} · {local.area_m2.toLocaleString('es-MX')} m² · {plan.nivel.nombre}</p>
        {local.ruta && <p>Desde {origen?.toLowerCase() ?? local.ruta.desde}: <Field value={local.ruta.texto} /></p>}
      </section>
      {vecinos.length > 0 && (
        <section>
          <h3 class="t-label">Vecinos</h3>
          <ul>{vecinos.map((v) => <li>{v.clave} · {texto(v.marca)}{v.giro && ` · ${texto(v.giro)}`}</li>)}</ul>
        </section>
      )}
      <section>
        <h3 class="t-label">Anclas</h3>
        <ul>{plaza.anclas.map((a) => <li>{a.marca} · {a.giro}{a.area_m2 && ` · ${a.area_m2.toLocaleString('es-MX')} m²`}</li>)}</ul>
      </section>
      <section>
        <h3 class="t-label">Accesos y estacionamiento</h3>
        <ul>{[...plan.info.accesos, ...plan.info.estacionamientos].map((a) => <li>{a.nombre}</li>)}</ul>
      </section>
    </div>
    <details class="texto__ocupantes desplegable">
      <summary><span>Otros locales del nivel</span> <span class="t-meta tabular">{ocupantes.length}</span></summary>
      <ul class="ocupantes">
        {ocupantes.map((o) => (
          <li>
            <span class="ocupante__clave t-meta tabular">{o.clave}</span>
            <span class="ocupante__marca">{texto(o.marca)}</span>
            <span class="ocupante__giro t-meta">{texto(o.giro)}</span>
          </li>
        ))}
      </ul>
    </details>
  </details>

  <script type="application/json" data-plano-info set:html={JSON.stringify(info).replace(/</g, '\\u003c')} />
</div>

<script>
  import { acercar, desplazar, escala, igual, type Vista } from '../../lib/plano/vista'

  for (const root of document.querySelectorAll<HTMLElement>('[data-plano]')) {
    const mapa = root.querySelector<HTMLElement>('[data-mapa]')!
    // Los gestos se escuchan en el lienzo (mapa + ficha) para que la ficha no los interrumpa.
    const lienzo = root.querySelector<HTMLElement>('.plano__lienzo')!
    const svg = root.querySelector<SVGSVGElement>('.plano__svg svg')!
    const info = JSON.parse(root.querySelector('[data-plano-info]')!.textContent ?? '{}') as Record<string, { clave: string; marca: string; giro: string; area?: string }>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const locales = [...svg.querySelectorAll<SVGGraphicsElement>('[data-clave]')]
    const parse = (v: string) => v.split(' ').map(Number) as Vista
    const completa = parse(root.dataset.viewCompleto!)
    const detalle = parse(root.dataset.viewDetalle!)
    let actual: Vista = completa
    let frame = 0

    // Rótulos, marcador y ficha en HTML: se reubican con cada viewBox (y se ocultan si quedan fuera).
    const rotulos = [...root.querySelectorAll<HTMLElement>('.plano__rotulos [data-x]')]
    const ficha = root.querySelector<HTMLElement>('[data-ficha]')!
    const mas = root.querySelector<HTMLButtonElement>('[data-zoom="mas"]')!
    const menos = root.querySelector<HTMLButtonElement>('[data-zoom="menos"]')!
    let seleccion: SVGGraphicsElement | undefined

    const colocar = ([x, y, w, h]: Vista) => {
      for (const el of rotulos) {
        const left = ((Number(el.dataset.x) - x) / w) * 100
        const top = ((Number(el.dataset.y) - y) / h) * 100
        el.style.left = `${left}%`
        el.style.top = `${top}%`
        el.hidden = left < -2 || left > 102 || top < -2 || top > 102
        if (el.classList.contains('marcador')) el.toggleAttribute('data-abajo', top < 40)
        if (!el.classList.contains('rotulo--lugar')) continue
        if (left < 12) el.dataset.borde = 'inicio'
        else if (left > 88) el.dataset.borde = 'fin'
        else delete el.dataset.borde
      }
      const z = escala(actual, completa)
      root.toggleAttribute('data-cerca', z >= 2)
      root.toggleAttribute('data-ampliado', z > 1.01)
      mas.disabled = z >= 7.99
      menos.disabled = z <= 1.01
      if (seleccion) ubicarFicha()
    }

    const aplicar = (v: Vista) => {
      actual = v
      svg.setAttribute('viewBox', v.join(' '))
      colocar(v)
    }

    // Transición animada a una vista (ease-in-out, 0.6 s); instantánea con movimiento reducido.
    const ir = (destino: Vista) => {
      cancelAnimationFrame(frame)
      const desde = actual
      if (reduce) return aplicar(destino)
      const inicio = performance.now()
      const paso = (now: number) => {
        const t = Math.min(1, (now - inicio) / 600)
        const e = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2
        aplicar(desde.map((d, i) => d + (destino[i]! - d) * e) as Vista)
        if (t < 1) frame = requestAnimationFrame(paso)
      }
      frame = requestAnimationFrame(paso)
    }

    /** Fracción (0–1) del mapa en la que cae un punto de la pantalla. */
    const fraccion = (clientX: number, clientY: number) => {
      const r = mapa.getBoundingClientRect()
      return [(clientX - r.left) / r.width, (clientY - r.top) / r.height] as const
    }
    /** Unidades del SVG por píxel de pantalla en la vista actual. */
    const porPixel = () => actual[2] / mapa.getBoundingClientRect().width

    mas.addEventListener('click', () => ir(acercar(actual, completa, 1.8)))
    menos.addEventListener('click', () => ir(acercar(actual, completa, 1 / 1.8)))
    for (const boton of root.querySelectorAll<HTMLButtonElement>('[data-ir]')) {
      boton.addEventListener('click', () => ir(boton.dataset.ir === 'detalle' ? detalle : completa))
    }

    // Pad y rueda: el pellizco del pad (y Ctrl + rueda) acerca o aleja en el punto del cursor.
    // El desplazamiento con dos dedos mueve el plano solo si está ampliado y aún puede moverse;
    // si no, el gesto sigue desplazando la página.
    lienzo.addEventListener('wheel', (e) => {
      if (e.ctrlKey) {
        e.preventDefault()
        cancelAnimationFrame(frame)
        aplicar(acercar(actual, completa, Math.exp(-Math.max(-50, Math.min(50, e.deltaY)) * 0.01), ...fraccion(e.clientX, e.clientY)))
        return
      }
      if (escala(actual, completa) <= 1.01) return
      const k = porPixel()
      const siguiente = desplazar(actual, completa, e.deltaX * k, e.deltaY * k)
      if (igual(siguiente, actual)) return
      e.preventDefault()
      cancelAnimationFrame(frame)
      aplicar(siguiente)
    }, { passive: false })

    // Arrastre con mouse o lápiz cuando el plano está ampliado. Un arrastre no cuenta como clic.
    let arrastre: { x: number; y: number; vista: Vista; movido: boolean } | undefined
    lienzo.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || escala(actual, completa) <= 1.01) return
      if ((e.target as Element).closest('button, [data-ficha]')) return
      arrastre = { x: e.clientX, y: e.clientY, vista: actual, movido: false }
    })
    addEventListener('pointermove', (e) => {
      if (!arrastre) return
      const dx = e.clientX - arrastre.x
      const dy = e.clientY - arrastre.y
      if (!arrastre.movido && Math.hypot(dx, dy) < 4) return
      arrastre.movido = true
      root.toggleAttribute('data-arrastrando', true)
      const k = porPixel()
      aplicar(desplazar(arrastre.vista, completa, -dx * k, -dy * k))
    })
    addEventListener('pointerup', () => {
      if (arrastre?.movido) {
        // El clic que sigue al arrastre no selecciona un local.
        lienzo.addEventListener('click', (e) => e.stopPropagation(), { capture: true, once: true })
      }
      arrastre = undefined
      root.removeAttribute('data-arrastrando')
    })

    // Dos dedos en la pantalla táctil: pellizcar acerca o aleja y mover desplaza. Un dedo sigue
    // desplazando la página (el plano no atrapa el scroll).
    let gesto: { d: number; cx: number; cy: number } | undefined
    const medir = (t: TouchList) => {
      const [a, b] = [t[0]!, t[1]!]
      return { d: Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY), cx: (a.clientX + b.clientX) / 2, cy: (a.clientY + b.clientY) / 2 }
    }
    lienzo.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) gesto = medir(e.touches)
    }, { passive: true })
    lienzo.addEventListener('touchmove', (e) => {
      if (e.touches.length !== 2 || !gesto) return
      if (e.cancelable) e.preventDefault()
      cancelAnimationFrame(frame)
      const m = medir(e.touches)
      const k = porPixel()
      const movida = desplazar(actual, completa, -(m.cx - gesto.cx) * k, -(m.cy - gesto.cy) * k)
      aplicar(acercar(movida, completa, m.d / gesto.d, ...fraccion(m.cx, m.cy)))
      gesto = m
    }, { passive: false })
    lienzo.addEventListener('touchend', (e) => {
      if (e.touches.length < 2) gesto = undefined
    })

    // Ficha del local: flota junto al local tocado, dentro del ancho del plano.
    const fichaClave = ficha.querySelector<HTMLElement>('[data-ficha-clave]')!
    const fichaMarca = ficha.querySelector<HTMLElement>('[data-ficha-marca]')!
    const fichaGiro = ficha.querySelector<HTMLElement>('[data-ficha-giro]')!
    const ubicarFicha = () => {
      if (!seleccion) return
      const marco = mapa.getBoundingClientRect()
      const caja = seleccion.getBoundingClientRect()
      const cx = caja.left + caja.width / 2 - marco.left
      const visible = caja.right > marco.left && caja.left < marco.right && caja.bottom > marco.top && caja.top < marco.bottom
      ficha.hidden = !visible
      if (!visible) return
      const ancho = ficha.offsetWidth
      const margen = 8
      ficha.style.left = `${Math.min(Math.max(cx - ancho / 2, margen), marco.width - ancho - margen) + (marco.left - lienzo.getBoundingClientRect().left)}px`
      // Arriba del local si hay espacio en el plano; si no, debajo (puede salir del plano).
      const arriba = caja.top - marco.top - ficha.offsetHeight - 10
      const abajo = caja.bottom - marco.top + 10
      ficha.style.top = `${arriba >= margen ? arriba : abajo}px`
    }
    const cerrar = () => {
      seleccion?.setAttribute('aria-pressed', 'false')
      seleccion = undefined
      ficha.hidden = true
    }
    const seleccionar = (el: SVGGraphicsElement) => {
      if (seleccion === el) return cerrar()
      const clave = el.dataset.clave!
      const i = info[clave]
      locales.forEach((l) => l.setAttribute('aria-pressed', String(l === el)))
      seleccion = el
      fichaClave.textContent = `Local ${clave}`
      fichaMarca.textContent = i?.marca ?? 'Sin información'
      fichaGiro.textContent = [i?.giro, i?.area].filter(Boolean).join(' · ')
      ficha.hidden = false
      ubicarFicha()
    }
    for (const el of locales) {
      el.addEventListener('click', () => seleccionar(el))
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          seleccionar(el)
        }
      })
    }
    ficha.querySelector('[data-ficha-cerrar]')!.addEventListener('click', () => {
      const anterior = seleccion
      cerrar()
      anterior?.focus()
    })
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && seleccion) {
        const anterior = seleccion
        cerrar()
        anterior.focus()
      }
    })
    document.addEventListener('click', (e) => {
      const t = e.target as Element
      if (seleccion && !t.closest('[data-ficha]') && !t.closest('[data-clave]')) cerrar()
    })
    addEventListener('resize', () => ubicarFicha())

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-capa-toggle]')) {
      button.addEventListener('click', () => {
        const on = button.getAttribute('aria-pressed') !== 'true'
        button.setAttribute('aria-pressed', String(on))
        root.toggleAttribute(`data-capa-${button.dataset.capaToggle}`, on)
      })
    }

    const rutaBtn = root.querySelector<HTMLButtonElement>('[data-ruta-toggle]')
    const rutaTexto = root.querySelector<HTMLElement>('[data-ruta-texto]')
    if (rutaBtn) {
      const path = svg.querySelector<SVGPathElement>(`[data-ref="${rutaBtn.dataset.rutaToggle}"]`)!
      rutaBtn.addEventListener('click', () => {
        const on = rutaBtn.getAttribute('aria-pressed') !== 'true'
        rutaBtn.setAttribute('aria-pressed', String(on))
        if (rutaTexto) rutaTexto.hidden = !on
        const length = path.getTotalLength()
        path.style.transition = 'none'
        path.style.strokeDasharray = `${length}`
        path.style.strokeDashoffset = on && !reduce ? `${length}` : '0'
        path.style.opacity = on ? '1' : '0'
        if (on && !reduce) {
          path.getBoundingClientRect()
          path.style.transition = 'stroke-dashoffset 1.2s cubic-bezier(0.16, 1, 0.3, 1)'
          path.style.strokeDashoffset = '0'
        }
      })
    }

    colocar(actual)
  }
</script>

<style>
  .plano {
