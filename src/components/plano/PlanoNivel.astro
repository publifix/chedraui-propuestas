---
// Plano interactivo de un nivel: local de la presentación resaltado, panel al tocar un local,
// capas activables, ruta desde el estacionamiento o un ancla, y versión en texto.
import Field from '../Field.astro'
import Label from '../Label.astro'
import { ocupantesDe, vecinosDe, type ResolvedFloorPlan, type ResolvedPresentation } from '../../lib/resolve'
import { esGiroAfin } from '../../lib/plano/afines'
import { frameAround, prepareSvg } from '../../lib/plano/svg'
import { isTodo } from '../../lib/todo'

interface Props {
  model: ResolvedPresentation
  plan: ResolvedFloorPlan
  kind: 'revision' | 'envio'
}

const { model, plan, kind } = Astro.props
const { plaza, giro } = model
const afines = giro.giros_afines ?? []
const ocupantes = ocupantesDe(model, plan.nivel.id)
const vb = plan.info.viewBox
const clave = plan.claves[0]!
const local = model.locales.find((l) => l.clave === clave)!
const vecinos = vecinosDe(model, local)
const sinDato = kind === 'revision' ? 'pendiente' : 'sin información'
const texto = (v: string | undefined) => (v === undefined || isTodo(v) ? sinDato : v)

// Datos del panel por clave: ocupantes del nivel y locales de la presentación.
type Info = { clave: string; marca: string; giro: string; area?: string; estado?: string; objetivo?: boolean; afin?: boolean }
const info: Record<string, Info> = {}
for (const o of ocupantes) {
  info[o.clave] = {
    clave: o.clave,
    marca: texto(o.marca),
    giro: texto(o.giro),
    ...(o.area_m2 && { area: `${o.area_m2.toLocaleString('es-MX')} m²` }),
    ...(esGiroAfin(o.giro, afines) && { afin: true }),
  }
}
for (const l of model.locales.filter((l) => plan.claves.includes(l.clave))) {
  info[l.clave] = { clave: l.clave, marca: `Local para ${model.prospecto.marca}`, giro: l.estado === 'disponible' ? 'Disponible' : 'Apartado', area: `${l.area_m2.toLocaleString('es-MX')} m²`, objetivo: true }
}
const categorias = new Map(ocupantes.map((o) => [o.clave, o.categoria ?? 'tienda']))
const attrs = Object.fromEntries(
  [...plan.info.locales.keys()].map((c) => {
    const i = info[c]
    const a: Record<string, string> = {
      tabindex: '0',
      role: 'button',
      'aria-pressed': 'false',
      'aria-label': i ? `Local ${c}: ${i.marca}, ${i.giro}` : `Local ${c}`,
      'data-categoria': categorias.get(c) ?? 'tienda',
    }
    if (i?.afin) a['data-afin'] = ''
    if (i?.objetivo) a['class'] = 'is-target'
    return [c, a]
  }),
)
const labels = Object.fromEntries(plan.claves.map((c) => [c, { class: 'is-target-label' }]))
const detalle = frameAround(plan.info.locales.get(clave)!.bbox, vb, { width: 480, ratio: 1 })
const svg = prepareSvg(plan.svg, { prefix: 'pi-', locales: attrs, labels, viewBox: detalle })
const view = (v: typeof vb) => `${v.x} ${v.y} ${v.width} ${v.height}`

const ruta = local.ruta && plan.info.rutas.find((r) => r.desde === local.ruta!.desde && r.hasta === clave)
const origen = ruta && plan.info.origenes.get(ruta.desde)
const restaurantes = ocupantes.filter((o) => o.categoria === 'restaurante').length
const nAfines = ocupantes.filter((o) => esGiroAfin(o.giro, afines)).length
const capas = [
  { id: 'anclas', nombre: 'Anclas', n: plan.info.anclas.length },
  { id: 'restaurantes', nombre: 'Restaurantes', n: restaurantes },
  { id: 'accesos', nombre: 'Accesos', n: plan.info.accesos.length },
  { id: 'estacionamiento', nombre: 'Estacionamiento', n: plan.info.estacionamientos.length },
  ...(afines.length > 0 ? [{ id: 'afines', nombre: `Afines a ${giro.nombre.toLowerCase()}`, n: nAfines }] : []),
].filter((c) => c.n > 0)
const id = `plano-${plan.nivel.id.toLowerCase()}`
---
<div class="plano" id={id} data-plano data-view-detalle={view(detalle)} data-view-completo={view(vb)}>
  <div class="plano__toolbar" role="group" aria-label="Capas del plano">
    {capas.map((c) => (
      <button type="button" class:list={['capa', `capa--${c.id}`]} aria-pressed="false" data-capa-toggle={c.id}>
        <span class="capa__muestra" aria-hidden="true"></span>{c.nombre}
      </button>
    ))}
    {ruta && (
      <button type="button" class="capa capa--ruta" aria-pressed="false" data-ruta-toggle={ruta.id}>
        <span class="capa__muestra" aria-hidden="true"></span>Ruta desde {origen?.toLowerCase()}
      </button>
    )}
  </div>

  <div class="plano__mapa">
    <div class="plano__svg" role="group" aria-label={`Plano esquemático de ${plan.nivel.nombre.toLowerCase()}. Toca un local para ver quién lo ocupa.`} set:html={svg} />
  </div>
  <div class="plano__pie">
    <p class="t-meta">Plano esquemático, no a escala.</p>
    <button type="button" class="plano__vista" data-vista aria-pressed="false">Ver planta completa</button>
  </div>

  <div class="plano__panel" aria-live="polite" data-panel>
    <Label as="p" class="panel__clave" text={`Local ${clave}`} />
    <p class="panel__marca">{info[clave]?.marca}</p>
    <p class="panel__giro t-meta">{info[clave]?.giro} · {info[clave]?.area}</p>
  </div>

  {ruta && (
    <p class="plano__ruta" data-ruta-texto hidden>
      <strong>Desde {origen?.toLowerCase()}:</strong> <Field value={local.ruta!.texto} />
    </p>
  )}

  <details class="plano__texto">
    <summary>Ver el plano en texto</summary>
    <div class="texto__grid">
      <section>
        <h3 class="t-label">Tu local</h3>
        <p>Local {clave} · {local.area_m2.toLocaleString('es-MX')} m² · {plan.nivel.nombre}</p>
        {local.ruta && <p>Desde {origen?.toLowerCase() ?? local.ruta.desde}: <Field value={local.ruta.texto} /></p>}
      </section>
      {vecinos.length > 0 && (
        <section>
          <h3 class="t-label">Vecinos</h3>
          <ul>{vecinos.map((v) => <li>{v.clave} · {texto(v.marca)}{v.giro && ` · ${texto(v.giro)}`}</li>)}</ul>
        </section>
      )}
      <section>
        <h3 class="t-label">Anclas</h3>
        <ul>{plaza.anclas.map((a) => <li>{a.marca} · {a.giro}{a.area_m2 && ` · ${a.area_m2.toLocaleString('es-MX')} m²`}</li>)}</ul>
      </section>
      <section>
        <h3 class="t-label">Accesos y estacionamiento</h3>
        <ul>{[...plan.info.accesos, ...plan.info.estacionamientos].map((a) => <li>{a.nombre}</li>)}</ul>
      </section>
      <section class="texto__ocupantes">
        <h3 class="t-label">Otros locales del nivel</h3>
        <ul>{ocupantes.map((o) => <li>{o.clave} · {texto(o.marca)} · {texto(o.giro)}</li>)}</ul>
      </section>
    </div>
  </details>

  <script type="application/json" data-plano-info set:html={JSON.stringify(info).replace(/</g, '\\u003c')} />
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-plano]')) {
    const svg = root.querySelector<SVGSVGElement>('.plano__svg svg')!
    const info = JSON.parse(root.querySelector('[data-plano-info]')!.textContent ?? '{}') as Record<string, { clave: string; marca: string; giro: string; area?: string }>
    const panel = root.querySelector<HTMLElement>('[data-panel]')!
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const locales = [...svg.querySelectorAll<SVGElement>('[data-clave]')]

    const select = (el: SVGElement) => {
      const clave = el.dataset.clave!
      const i = info[clave]
      locales.forEach((l) => l.setAttribute('aria-pressed', String(l === el)))
      panel.querySelector('.panel__clave')!.textContent = `Local ${clave}`
      panel.querySelector('.panel__marca')!.textContent = i?.marca ?? 'Sin información'
      panel.querySelector('.panel__giro')!.textContent = [i?.giro, i?.area].filter(Boolean).join(' · ')
    }
    for (const el of locales) {
      el.addEventListener('click', () => select(el))
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          select(el)
        }
      })
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-capa-toggle]')) {
      button.addEventListener('click', () => {
        const on = button.getAttribute('aria-pressed') !== 'true'
        button.setAttribute('aria-pressed', String(on))
        root.toggleAttribute(`data-capa-${button.dataset.capaToggle}`, on)
      })
    }

    const vista = root.querySelector<HTMLButtonElement>('[data-vista]')!
    vista.addEventListener('click', () => {
      const completo = vista.getAttribute('aria-pressed') !== 'true'
      vista.setAttribute('aria-pressed', String(completo))
      vista.textContent = completo ? 'Acercar al local' : 'Ver planta completa'
      svg.setAttribute('viewBox', completo ? root.dataset.viewCompleto! : root.dataset.viewDetalle!)
      root.toggleAttribute('data-completo', completo)
    })

    const rutaBtn = root.querySelector<HTMLButtonElement>('[data-ruta-toggle]')
    const rutaTexto = root.querySelector<HTMLElement>('[data-ruta-texto]')
    if (rutaBtn) {
      const path = svg.querySelector<SVGPathElement>(`[data-ref="${rutaBtn.dataset.rutaToggle}"]`)!
      rutaBtn.addEventListener('click', () => {
        const on = rutaBtn.getAttribute('aria-pressed') !== 'true'
        rutaBtn.setAttribute('aria-pressed', String(on))
        if (rutaTexto) rutaTexto.hidden = !on
        const length = path.getTotalLength()
        path.style.transition = 'none'
        path.style.strokeDasharray = `${length}`
        path.style.strokeDashoffset = on && !reduce ? `${length}` : '0'
        path.style.opacity = on ? '1' : '0'
        if (on && !reduce) {
          path.getBoundingClientRect()
          path.style.transition = 'stroke-dashoffset 1.2s cubic-bezier(0.16, 1, 0.3, 1)'
          path.style.strokeDashoffset = '0'
        }
      })
    }
  }
</script>

<style>
  .plano {
    display: grid;
    gap: var(--space-s);
  }

  .plano__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .capa {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 44px;
    padding: var(--space-3xs) var(--space-s);
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .capa[aria-pressed='true'] {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 var(--line-width) var(--color-accent);
    font-weight: var(--strong-weight);
  }

  .capa__muestra {
    inline-size: var(--space-s);
    block-size: var(--space-s);
    border-radius: var(--radius-s);
    background: var(--color-accent-soft);
  }

  .capa--anclas .capa__muestra {
    background: color-mix(in srgb, var(--color-accent-soft) 35%, var(--color-surface));
    box-shadow: inset 0 0 0 calc(var(--line-width) * 2) var(--color-accent);
  }

  .capa--afines .capa__muestra {
    background: color-mix(in srgb, var(--color-accent-soft) 40%, var(--color-surface));
    outline: var(--line-width) dashed var(--color-accent);
    outline-offset: -1px;
  }

  .capa--estacionamiento .capa__muestra {
    background: color-mix(in srgb, var(--color-accent-soft) 30%, var(--color-surface));
    outline: var(--line-width) dashed var(--color-accent-soft);
  }

  .capa--accesos .capa__muestra {
    border-radius: 50%;
    background: var(--color-accent);
  }

  .capa--ruta .capa__muestra {
    block-size: calc(var(--line-width) * 3);
    background: var(--color-accent);
  }

  .plano__mapa {
    position: relative;
    overflow: hidden;
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-bg);
    touch-action: pan-y;
  }

  .plano__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
  }

  .plano__vista {
    min-block-size: 44px;
    padding: var(--space-3xs) var(--space-s);
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .plano__panel {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-inline-start: calc(var(--line-width) * 3) solid var(--color-accent);
    background: var(--color-surface);
  }

  .panel__marca {
    font-size: var(--step-2);
    font-weight: var(--strong-weight);
    line-height: 1.15;
  }

  .plano__ruta[hidden] {
    display: none;
  }

  .plano__texto {
    border-block-start: var(--line-width) solid var(--color-line);
    padding-block-start: var(--space-s);
  }

  .plano__texto summary {
    min-block-size: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: var(--strong-weight);
  }

  .texto__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l);
    padding-block: var(--space-s);
  }

  .texto__grid h3 {
    margin-block-end: var(--space-2xs);
    color: var(--color-text-muted);
  }

  .texto__grid ul {
    padding-inline-start: 1.1em;
  }

  .texto__ocupantes {
    grid-column: 1 / -1;
  }

  .texto__ocupantes ul {
    columns: 16rem;
  }

  /* Estados del SVG (contenido insertado: selectores globales dentro del plano). */
  .plano :global([data-clave]) {
    cursor: pointer;
    transition: stroke-width var(--duration-fast) var(--ease-out);
  }

  .plano :global([data-clave]:hover),
  .plano :global([data-clave]:focus-visible) {
    stroke: var(--color-accent);
    stroke-width: 5;
    outline: none;
  }

  .plano :global([data-clave][aria-pressed='true']) {
    stroke: var(--color-text);
    stroke-width: 5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .plano :global(.is-target) {
      animation: pulso 1.8s ease-in-out 3;
    }
  }

  @keyframes pulso {
    50% {
      fill-opacity: 0.55;
    }
  }

  /* Cada capa tiene un tratamiento distinto para poder combinarlas: anclas con contorno grueso,
     restaurantes con relleno sólido y giros afines con relleno tenue y borde discontinuo. */
  .plano[data-capa-anclas] :global([data-capa='anclas'] > *) {
    stroke: var(--color-accent);
    stroke-width: 8;
  }

  .plano[data-capa-restaurantes] :global([data-categoria='restaurante']) {
    fill: var(--color-accent-soft);
  }

  .plano[data-capa-afines] :global([data-afin]) {
    fill: color-mix(in srgb, var(--color-accent-soft) 40%, var(--color-surface));
    stroke: var(--color-accent);
    stroke-width: 3;
    stroke-dasharray: 6 4;
  }

  .plano[data-capa-estacionamiento] :global([data-capa='estacionamiento'] > *) {
    fill: color-mix(in srgb, var(--color-accent-soft) 30%, var(--color-surface));
    stroke: var(--color-accent-soft);
  }

  .plano[data-capa-accesos] :global([data-capa='accesos'] > *) {
    fill: var(--color-accent);
    r: 16px;
  }

  /* En la planta completa los rótulos de los locales no caben: se ocultan. */
  .plano[data-completo] :global([data-capa='etiquetas'] text[data-para]:not([data-para^='ancla']):not([data-para^='estacionamiento']):not([data-para='marina'])) {
    display: none;
  }
</style>
