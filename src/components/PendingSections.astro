---
// Marcador del paso 4: las secciones de contenido se construyen en el paso 5.
import Screen from './Screen.astro'
import type { ResolvedPresentation } from '../lib/resolve'

interface Props {
  model: ResolvedPresentation
}

const { model } = Astro.props
const [local] = model.locales
---
<Screen section="Portada" labelledby="pendiente-titulo">
  <h1 id="pendiente-titulo" class="t-display">Para {model.prospecto.marca}</h1>
  <p class="t-label meta">{model.plaza.nombre} · {local?.clave}</p>
  <p class="t-lead">Layout base listo. Las secciones de contenido se construyen en el paso 5.</p>
</Screen>

<style>
  .meta {
    margin-block: var(--space-s) var(--space-m);
    color: var(--color-accent);
  }
</style>
