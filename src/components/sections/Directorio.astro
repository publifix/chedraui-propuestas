---
// 12 · Directorio: marcas de la plaza en tarjetas uniformes. Sin logo, la marca va como marca
// tipográfica en la familia de display de la plaza; con logo (opcional), el logo.
import Headline from '../Headline.astro'
import Screen from '../Screen.astro'
import { Image } from 'astro:assets'
import { plazaImage } from '../../lib/media'
import { SECTION_IDS } from '../../lib/sections'
import type { SectionProps } from './types'

type Props = SectionProps

const { model } = Astro.props
const { plaza } = model
const marcas = plaza.directorio ?? []
const logos = await Promise.all(marcas.map((m) => plazaImage(plaza.slug, m.logo)))
---
{marcas.length > 0 && (
  <Screen section={SECTION_IDS.Directorio} labelledby="directorio-titulo" align="start">
    <Headline id="directorio-titulo" text="Directorio" />
    <ul class="marcas">
      {marcas.map((m, i) => {
        const logo = logos[i]
        return (
          <li class="marca">
            {logo ? <Image src={logo} alt={m.marca} width={160} densities={[1, 2]} class="marca__logo" /> : <span class="marca__nombre">{m.marca}</span>}
            <span class="marca__giro t-meta">{m.giro}</span>
          </li>
        )
      })}
    </ul>
    <p class="t-meta nota">Entre otras marcas.</p>
  </Screen>
)}

<style>
  .marcas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 6.25rem), 1fr));
    gap: var(--line-width);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border: var(--line-width) solid var(--color-line);
  }

  .marca {
    display: grid;
    align-content: center;
    gap: var(--space-3xs);
    min-block-size: 4.5rem;
    padding: var(--space-xs) var(--space-2xs);
    background: var(--color-bg);
    text-align: center;
  }

  .marca__nombre {
    font-family: var(--font-display);
    font-weight: var(--title-long-weight);
    font-stretch: var(--title-long-stretch);
    letter-spacing: var(--title-long-tracking);
    font-size: var(--step-0);
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .marca__logo {
    max-block-size: 2.5rem;
    inline-size: auto;
    margin-inline: auto;
  }

  .marca__giro {
    font-size: var(--step--2, 0.75rem);
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  .nota {
    margin-block-start: var(--space-s);
  }
</style>
