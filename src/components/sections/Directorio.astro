---
// 12 · Directorio: marcas de la plaza en tarjetas uniformes. Sin logo, la marca va como marca
// tipográfica en la familia de display de la plaza; con logo (opcional), el logo.
import Headline from '../Headline.astro'
import Screen from '../Screen.astro'
import { Image } from 'astro:assets'
import { plazaImage } from '../../lib/media'
import { SECTION_IDS } from '../../lib/sections'
import type { SectionProps } from './types'

type Props = SectionProps

const { model } = Astro.props
const { plaza } = model
const marcas = plaza.directorio ?? []
const logos = await Promise.all(marcas.map((m) => plazaImage(plaza.slug, m.logo)))
---
{marcas.length > 0 && (
  <Screen section={SECTION_IDS.Directorio} labelledby="directorio-titulo" align="start" compact>
    <Headline id="directorio-titulo" text="Directorio" />
    <ul class="marcas" id="directorio-marcas" data-marcas>
      {marcas.map((m, i) => {
        const logo = logos[i]
        return (
          <li class="marca">
            {logo ? <Image src={logo} alt={m.marca} width={160} densities={[1, 2]} class="marca__logo" /> : <span class="marca__nombre">{m.marca}</span>}
            <span class="marca__giro t-meta">{m.giro}</span>
          </li>
        )
      })}
    </ul>
    <button type="button" class="directorio__mas" aria-controls="directorio-marcas" aria-expanded="false" data-mas hidden>
      <span data-mas-texto>Ver las {marcas.length} marcas</span>
    </button>
    <p class="t-meta nota">Entre otras marcas.</p>
  </Screen>
)}

<script>
  // Muestra las tres primeras filas del directorio y el resto al pedirlo. Sin JS se ve completo.
  for (const lista of document.querySelectorAll<HTMLElement>('[data-marcas]')) {
    const boton = lista.parentElement!.querySelector<HTMLButtonElement>('[data-mas]')!
    const texto = boton.querySelector<HTMLElement>('[data-mas-texto]')!
    const items = [...lista.children] as HTMLElement[]
    const total = texto.textContent
    let abierto = false
    const aplicar = () => {
      const columnas = getComputedStyle(lista).gridTemplateColumns.split(' ').length
      const visibles = columnas * 3
      boton.hidden = items.length <= visibles
      items.forEach((item, i) => (item.hidden = !abierto && i >= visibles))
      lista.toggleAttribute('data-recortado', !abierto && items.length > visibles)
      boton.setAttribute('aria-expanded', String(abierto))
      texto.textContent = abierto ? 'Ver menos marcas' : total
    }
    boton.addEventListener('click', () => {
      abierto = !abierto
      aplicar()
      if (!abierto) lista.scrollIntoView({ block: 'nearest' })
    })
    addEventListener('resize', aplicar)
    aplicar()
  }
</script>

<style>
  .marcas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 6.25rem), 1fr));
    gap: var(--line-width);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border: var(--line-width) solid var(--color-line);
  }

  .marca {
    display: grid;
    align-content: center;
    gap: var(--space-3xs);
    min-block-size: 4.5rem;
    padding: var(--space-xs) var(--space-2xs);
    background: var(--color-bg);
    text-align: center;
  }

  .marca__nombre {
    font-family: var(--font-display);
    font-weight: var(--title-long-weight);
    font-stretch: var(--title-long-stretch);
    letter-spacing: var(--title-long-tracking);
    font-size: var(--step-0);
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .marca__logo {
    max-block-size: 2.5rem;
    inline-size: auto;
    margin-inline: auto;
  }

  .marca__giro {
    font-size: var(--step--2, 0.75rem);
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  .marca[hidden] {
    display: none;
  }

  .directorio__mas {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 44px;
    margin-block-start: var(--space-m);
    padding: var(--space-3xs) var(--space-m);
    border: var(--line-width) solid var(--color-accent);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: var(--strong-weight);
    cursor: pointer;
  }

  .directorio__mas[hidden] {
    display: none;
  }

  /* Flecha que gira al abrir, como en los desplegables. */
  .directorio__mas::after {
    content: '';
    inline-size: 0.5em;
    block-size: 0.5em;
    border-inline-end: calc(var(--line-width) * 2) solid currentColor;
    border-block-end: calc(var(--line-width) * 2) solid currentColor;
    transform: translateY(-25%) rotate(45deg);
  }

  .directorio__mas[aria-expanded='true']::after {
    transform: translateY(25%) rotate(-135deg);
  }

  .directorio__mas:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }

  .nota {
    margin-block-start: var(--space-s);
  }
</style>
