---
// 3 · Métricas: cifras de la plaza con fuente y periodo siempre visibles (CLAUDE.md §4.6).
// Los números suben al entrar en pantalla; sin JS o con movimiento reducido se ven ya completos.
// La cifra existe una sola vez en el documento: durante la cuenta, el texto real queda
// transparente (los lectores de pantalla leen el valor final) y encima se pinta una copia
// decorativa que se retira al terminar.
import Field from '../Field.astro'
import Headline from '../Headline.astro'
import Label from '../Label.astro'
import Screen from '../Screen.astro'
import { SECTION_IDS } from '../../lib/sections'
import type { SectionProps } from './types'

type Props = SectionProps

const { model } = Astro.props

/** "+600 mil" → { prefix: "+", value: 600, suffix: " mil", decimals: 0 }. Sin comas en el valor
 * ("2012", un año) la cuenta no agrupa miles. */
function parseValor(valor: string) {
  const match = /^(\D*?)(\d[\d,]*(?:\.\d+)?)(.*)$/.exec(valor)
  if (!match) return undefined
  const [, prefix = '', digits = '', suffix = ''] = match
  return { prefix, digits, value: Number(digits.replace(/,/g, '')), suffix, decimals: digits.split('.')[1]?.length ?? 0, grouping: digits.includes(',') }
}

const metricas = model.plaza.metricas.map((m) => ({ ...m, parsed: parseValor(m.valor) }))
---
<Screen section={SECTION_IDS.Metricas} labelledby="metricas-titulo" align="start">
  <Headline id="metricas-titulo" text="La plaza en cifras" />
  <dl class="metricas">
    {metricas.map((m) => (
      <div class="metrica">
        <dt class="metrica__etiqueta"><Label as="span" text={m.etiqueta} /></dt>
        <dd class="metrica__valor t-figure">
          {m.parsed ? (
            <span class="metrica__cifra">{m.parsed.prefix}<span class="metrica__num" data-counter={m.parsed.value} data-decimals={m.parsed.decimals} data-grouping={String(m.parsed.grouping)}>{m.parsed.digits}</span>{m.parsed.suffix.trim() && <>{' '}<span class="metrica__unidad">{m.parsed.suffix.trim()}</span></>}</span>
          ) : m.valor}
        </dd>
        <dd class="metrica__fuente t-meta">
          Fuente: <Field value={m.fuente} /> · Periodo: <Field value={m.periodo} />
        </dd>
      </div>
    ))}
  </dl>
</Screen>

<script>
  // Cuenta de 0 al valor final cuando la cifra entra en pantalla (ease-out, ~1.2 s).
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduce && 'IntersectionObserver' in window && counters.length > 0) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.counter)
      const decimals = Number(el.dataset.decimals ?? 0)
      const useGrouping = el.dataset.grouping === 'true'
      const format = (n: number) => n.toLocaleString('es-MX', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping })
      const overlay = document.createElement('span')
      overlay.className = 'metrica__cuenta'
      overlay.setAttribute('aria-hidden', 'true')
      overlay.textContent = format(0)
      el.classList.add('is-counting')
      el.append(overlay)
      const start = performance.now()
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 1200)
        overlay.textContent = format(target * (1 - (1 - t) ** 3))
        if (t < 1) {
          requestAnimationFrame(step)
          return
        }
        overlay.remove()
        el.classList.remove('is-counting')
      }
      requestAnimationFrame(step)
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        run(entry.target as HTMLElement)
        observer.unobserve(entry.target)
      }
    }, { threshold: 0.6 })
    counters.forEach((el) => observer.observe(el))
  }
</script>

<style>
  /* Cuatro cifras: una fila en escritorio, dos por dos en celular. Cada métrica usa las filas
     de la cuadrícula (subgrid) para que cifras, etiquetas y fuentes queden alineadas. */
  .metricas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-m);
    margin-block-start: var(--space-xl);
    /* El contenedor es la cuadrícula: una métrica con container-type dejaría de ser subgrid. */
    container-type: inline-size;
  }

  @media (min-width: 56rem) {
    .metricas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-l);
    }
  }

  .metrica {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    border-block-start: var(--line-width) solid var(--color-line);
  }

  .metrica__etiqueta {
    order: 2;
    color: var(--color-text-muted);
  }

  /* Etiquetas en ancho normal: "ESTACIONAMIENTO" cabe en media pantalla de 360 px. */
  .metrica__etiqueta :global(.t-label) {
    font-stretch: 100%;
    letter-spacing: 0.08em;
  }

  .metrica__valor {
    order: 1;
    align-self: end;
    white-space: nowrap;
    /* La cifra cabe siempre en su columna: se ajusta al ancho de la cuadrícula (2 o 4 columnas). */
    font-size: min(calc(var(--step-5) * var(--figure-size)), 11.5cqi);
  }

  @media (min-width: 56rem) {
    .metrica__valor {
      font-size: min(calc(var(--step-5) * var(--figure-size)), 5.4cqi);
    }
  }

  .metrica__fuente {
    order: 3;
  }

  .metrica__cifra {
    display: inline;
  }

  .metrica__num {
    position: relative;
    display: inline-block;
  }

  /* Unidad (m², mil) más pequeña, en la misma línea base que la cifra. */
  .metrica__unidad {
    font-size: 0.5em;
    font-weight: var(--strong-weight);
  }

  .metrica__num.is-counting {
    color: transparent;
  }

  /* Copia decorativa de la cuenta, alineada al inicio sobre el número real. */
  .metrica__num :global(.metrica__cuenta) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    color: var(--color-text);
    white-space: nowrap;
  }
</style>
