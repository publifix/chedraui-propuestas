---
// 5 · Anclas: marcas ancla de la plaza con su giro y superficie.
import Headline from '../Headline.astro'
import Label from '../Label.astro'
import Screen from '../Screen.astro'
import { Image } from 'astro:assets'
import { plazaImage } from '../../lib/media'
import { SECTION_IDS } from '../../lib/sections'
import { isTodo } from '../../lib/todo'
import type { SectionProps } from './types'

type Props = SectionProps

const { model, kind } = Astro.props
const { plaza } = model
const area = (m2: number) => `${m2.toLocaleString('es-MX')} m²`
const logos = await Promise.all(plaza.anclas.map((a) => plazaImage(plaza.slug, a.logo)))
---
<Screen section={SECTION_IDS.Anclas} labelledby="anclas-titulo" align="start">
  <Headline id="anclas-titulo" text="Marcas ancla" />
  <ul class="anclas">
    {plaza.anclas.map((a, i) => {
      const logo = logos[i]
      return (
        <li class="ancla">
          <div class="ancla__marca">
            {logo ? <Image src={logo} alt={a.marca} width={200} densities={[1, 2]} class="ancla__logo" /> : <span class="ancla__nombre">{a.marca}</span>}
          </div>
          <Label class="ancla__giro" text={a.giro} />
          {a.area_m2 && <p class="t-figure">{area(a.area_m2)}</p>}
          {kind === 'revision' && isTodo(a.logo) && <span class="todo">{a.logo}</span>}
        </li>
      )
    })}
  </ul>
</Screen>

<style>
  .anclas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .ancla {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: calc(var(--line-width) * 2) solid var(--color-accent);
  }

  .ancla__nombre {
    font-family: var(--font-display);
    font-weight: var(--title-long-weight);
    font-stretch: var(--title-long-stretch);
    font-size: var(--step-3);
    line-height: 1;
  }

  .ancla__logo {
    block-size: 3rem;
    inline-size: auto;
  }

  .ancla :global(.ancla__giro) {
    color: var(--color-text-muted);
  }
</style>
