---
// 13 · Cierre, a sangre en el color de marca: frase de cierre, WhatsApp al asesor con mensaje
// prellenado, vigencia y estado de propuesta vencida (se comprueba en el navegador).
import Field from '../Field.astro'
import Headline from '../Headline.astro'
import Label from '../Label.astro'
import Screen from '../Screen.astro'
import SiVencida from '../SiVencida.astro'
import { SECTION_IDS } from '../../lib/sections'
import { formatVigencia } from '../../lib/vigencia'
import { mensajeCierre, mensajeVencida, whatsappUrl } from '../../lib/whatsapp'
import type { SectionProps } from './types'

type Props = SectionProps

const { model } = Astro.props
const { asesor, prospecto, plaza } = model
const vigencia = formatVigencia(model.vigencia)
const mensaje = mensajeCierre({
  asesor: asesor.nombre,
  marca: prospecto.marca,
  locales: model.locales.map((l) => l.clave),
  plaza: plaza.nombre,
})
const whatsapp = whatsappUrl(asesor.whatsapp, mensaje)
const whatsappVencida = whatsappUrl(asesor.whatsapp, mensajeVencida({ asesor: asesor.nombre, marca: prospecto.marca, locales: model.locales.map((l) => l.clave), plaza: plaza.nombre }))
---
<Screen section={SECTION_IDS.Cierre} tone="brand" labelledby="cierre-titulo">
  <div class="cierre">
    <Headline id="cierre-titulo" size="display" text={model.narrativa.cierre} />

    <div class="cierre__vigente">
      <a class="boton" href={whatsapp} target="_blank" rel="noopener" data-cta="whatsapp">
        <svg class="boton__icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.2-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
        <span>Escribir a {asesor.nombre.split(" ")[0]} por WhatsApp</span>
      </a>
      <p class="cierre__vigencia">Propuesta vigente hasta el <time datetime={model.vigencia}>{vigencia}</time>.</p>
    </div>

    <SiVencida>
    <div class="cierre__vencida">
      <p class="cierre__aviso">Esta propuesta venció el <time datetime={model.vigencia}>{vigencia}</time>.</p>
      <p>Para actualizar las condiciones, contacta a {asesor.nombre}.</p>
      <a class="boton" href={whatsappVencida} target="_blank" rel="noopener" data-cta="whatsapp-vencida">
        <span>Pedir una propuesta actualizada</span>
      </a>
    </div>
    </SiVencida>

    <div class="asesor">
      <Label text="Tu contacto" />
      <p class="asesor__nombre"><Field value={asesor.nombre} /></p>
      {asesor.puesto && <p class="t-meta">{asesor.puesto}</p>}
      <p class="t-meta tabular">WhatsApp {asesor.whatsapp}{asesor.correo && <> · <a href={`mailto:${asesor.correo}`}>{asesor.correo}</a></>}</p>
    </div>
  </div>
</Screen>

<style>
  .cierre {
    display: grid;
    gap: var(--space-xl);
    justify-items: start;
  }

  .cierre__vigente,
  .cierre__vencida {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  :global(.is-vencida) .cierre__vigente {
    display: none;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 48px;
    padding: var(--space-xs) var(--space-l);
    background: var(--color-on-brand);
    color: var(--color-brand);
    border-radius: var(--radius-m);
    font-weight: var(--strong-weight);
    text-decoration: none;
  }

  .boton:hover {
    color: var(--color-brand);
    background: color-mix(in srgb, var(--color-on-brand) 88%, var(--color-brand));
  }

  .boton:focus-visible {
    outline-color: var(--color-on-brand);
  }

  @media (prefers-reduced-motion: no-preference) {
    .boton {
      transition: background var(--duration-fast) var(--ease-out);
    }
  }

  .boton__icono {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .cierre__aviso {
    font-size: var(--step-2);
    font-weight: var(--strong-weight);
  }

  .asesor {
    display: grid;
    gap: var(--space-3xs);
    padding-block-start: var(--space-m);
    border-block-start: var(--line-width) solid var(--color-line);
    inline-size: 100%;
  }

  .asesor__nombre {
    font-size: var(--step-2);
  }
</style>
