---
// 6 · PlanoInteractivo: el plano del nivel con el local marcado, desde la planta completa.
import '../../styles/plano.css'
import Headline from '../Headline.astro'
import Screen from '../Screen.astro'
import PlanoNivel from '../plano/PlanoNivel.astro'
import { SECTION_IDS } from '../../lib/sections'
import type { SectionProps } from './types'

type Props = SectionProps

const { model, kind } = Astro.props
const plan = model.planos[0]
---
{plan ? (
  <Screen section={SECTION_IDS.PlanoInteractivo} labelledby="plano-titulo" align="start">
    <Headline id="plano-titulo" text={`Tu local en ${plan.nivel.nombre.toLowerCase()}`} />
    <p class="t-lead intro">Así se ubica el local dentro de la plaza. Acércate para ver a sus vecinos y resalta lo que te interesa.</p>
    {model.planos.map((p) => <PlanoNivel model={model} plan={p} kind={kind} />)}
  </Screen>
) : kind === 'revision' && (
  <Screen section={SECTION_IDS.PlanoInteractivo} compact>
    <p class="todo">PlanoInteractivo: el nivel del local no tiene plano todavía (niveles[].plano).</p>
  </Screen>
)}

<style>
  .intro {
    margin-block: var(--space-s) var(--space-l);
  }
</style>
