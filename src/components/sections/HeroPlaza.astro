---
// 2 · HeroPlaza: imagen a sangre, nombre de la plaza y zona.
import Headline from '../Headline.astro'
import Label from '../Label.astro'
import PlazaImage from '../PlazaImage.astro'
import Screen from '../Screen.astro'
import { SECTION_IDS } from '../../lib/sections'
import type { SectionProps } from './types'

type Props = SectionProps

const { model, kind } = Astro.props
const { plaza } = model
---
<Screen section={SECTION_IDS.HeroPlaza} labelledby="hero-titulo" bleed align="start">
  <figure class="hero">
    <PlazaImage
      plaza={plaza.slug}
      ruta={plaza.hero.imagen}
      alt={plaza.hero.alt}
      ratio="4/5"
      sizes="100vw"
      widths={[360, 540, 720, 1080, 1440, 2048]}
      kind={kind}
      falta="imagen principal (hero.imagen)"
      class="hero__image"
    />
    <figcaption class="hero__caption" data-reveal>
      <Headline id="hero-titulo" size="display" text={plaza.nombre_completo ?? plaza.nombre} />
      <Label class="hero__zona" text={plaza.ubicacion.zona} />
      <p class="t-meta">{plaza.ubicacion.ciudad}, {plaza.ubicacion.estado}</p>
    </figcaption>
  </figure>
</Screen>

<style>
  .hero {
    display: grid;
  }

  .hero :global(.hero__image) {
    border-radius: 0;
    max-block-size: 78svh;
  }

  .hero__caption {
    display: grid;
    gap: var(--space-xs);
    inline-size: 100%;
    max-inline-size: 72rem;
    margin-inline: auto;
    padding: var(--space-xl) max(var(--space-m), env(safe-area-inset-right)) var(--space-2xl) max(var(--space-m), env(safe-area-inset-left));
  }

  .hero :global(.hero__zona) {
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .hero :global(.hero__image) {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>
