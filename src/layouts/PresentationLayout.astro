---
import '../styles/base.css'
import { getImage } from 'astro:assets'
import Footer from '../components/sections/Footer.astro'
import Label from '../components/Label.astro'
import type { ResolvedPresentation } from '../lib/resolve'
import { plazaImage } from '../lib/media'
import { withBase } from '../lib/paths'
import { fontFaceCss, preloadUrls, themeCss, themeFonts } from '../lib/theme'
import { Image } from 'astro:assets'
import { presentationMeta } from '../lib/meta'
import type { PresentationRoute } from '../lib/routes'
import { isShortText } from '../lib/typography'
import { expiryScript, formatVigencia } from '../lib/vigencia'
import { mensajeVencida, whatsappUrl } from '../lib/whatsapp'

interface Props {
  model: ResolvedPresentation
  kind: 'revision' | 'envio'
  /** Ruta de la página (relativa al base), para og:url. */
  route: Pick<PresentationRoute, 'path'>
  /** Familias extra que necesita la página (p. ej. la muestra de tokens). */
  extraFonts?: string[]
  title?: string
}

const { model, kind, route, extraFonts = [], title } = Astro.props
const { plaza, prospecto, asesor } = model
const { tema } = plaza
const isRevision = kind === 'revision'

const fonts = [...themeFonts(tema.tipografias), ...extraFonts]
const meta = presentationMeta(model, route, Astro.site!, import.meta.env.BASE_URL)
const pageTitle = title ?? meta.title
const logo = await plazaImage(plaza.slug, tema.logo)
const vigencia = formatVigencia(model.vigencia)
const claves = model.locales.map((l) => l.clave)
const whatsappVencida = whatsappUrl(
  asesor.whatsapp,
  mensajeVencida({ asesor: asesor.nombre, marca: prospecto.marca, locales: claves, plaza: plaza.nombre }),
)
const icono = await plazaImage(plaza.slug, tema.icono)
const favicon = icono ? (await getImage({ src: icono, width: 64, height: 64, format: 'png' })).src : withBase('favicon.svg')
const appleIcon = icono ? (await getImage({ src: icono, width: 180, height: 180, format: 'png' })).src : undefined
const pendientes = model.pendientes
---
<!doctype html>
<html lang="es" class:list={[isRevision ? 'is-revision' : 'is-envio']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={meta.robots} />
    <script is:inline set:html={expiryScript(model.vigencia)} />
    <title>{pageTitle}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content={tema.colores.fondo} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={plaza.nombre_completo ?? plaza.nombre} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:image" content={meta.image.url} />
    {meta.image.type && <meta property="og:image:type" content={meta.image.type} />}
    <meta property="og:image:width" content={String(meta.image.width)} />
    <meta property="og:image:height" content={String(meta.image.height)} />
    <meta property="og:image:alt" content={meta.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image.url} />
    <link rel="icon" href={favicon} />
    {appleIcon && <link rel="apple-touch-icon" href={appleIcon} />}
    {preloadUrls([tema.tipografias.display, tema.tipografias.cuerpo]).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaceCss(fonts)} />
    <style is:inline set:html={themeCss(tema)} />
    <script is:inline>
      // Prepara la animación de entrada solo si el navegador puede ejecutarla y el
      // usuario no pidió reducir movimiento; si el script de reveal no corre, se descubre todo.
      if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        var root = document.documentElement
        root.classList.add('reveal-ready')
        setTimeout(function () { if (!root.dataset.revealing) root.classList.remove('reveal-ready') }, 3000)
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div class="chrome">
      {isRevision && (
        <aside class="review-banner" aria-label="Vista previa interna">
          <Label as="span" text="Vista previa interna · sin registro" />
          {pendientes.length > 0 && (
            <details class="review-banner__todos">
              <summary class="t-label">{pendientes.length} pendientes</summary>
              <ol>
                {pendientes.map((todo) => (
                  <li>
                    <code>{todo.path}</code> <span>{todo.text}</span>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </aside>
      )}
      <header class="site-header">
        <span class:list={['site-header__brand', isShortText(plaza.nombre) ? 'is-short' : 'is-long']}>
          {plaza.nombre}
        </span>
        <span class:list={['t-label', 'site-header__recipient', !isShortText(`Propuesta para ${prospecto.marca}`) && 'is-long']}>
          <span class="site-header__para">Propuesta para </span>{prospecto.marca}
        </span>
        <div class="progress" aria-hidden="true"><span class="progress__bar"></span></div>
      </header>
    </div>

    <main id="contenido" tabindex="-1">
      {!isRevision && (
        <section class="vencida" aria-labelledby="vencida-titulo">
          {logo && <Image src={logo} alt={plaza.nombre} width={200} densities={[1, 2]} class="vencida__logo" />}
          <h1 id="vencida-titulo" class="vencida__titulo">Esta propuesta venció el <time datetime={model.vigencia}>{vigencia}</time>.</h1>
          <Label text={`Propuesta para ${prospecto.marca}`} />
          <p class="t-lead">Para revisar las condiciones vigentes, pide una propuesta actualizada a {asesor.nombre}.</p>
          <a class="vencida__boton" href={whatsappVencida} target="_blank" rel="noopener" data-cta="whatsapp-vencida">Solicitar propuesta actualizada por WhatsApp</a>
        </section>
      )}
      {isRevision && (
        <p class="aviso-vencida todo" role="note">Esta propuesta venció el {vigencia}: en el link de envío el prospecto solo ve el aviso de propuesta vencida.</p>
      )}
      <div class="contenido">
        <slot />
      </div>
    </main>

    <Footer model={model} kind={kind} />

    <script>
      const root = document.documentElement
      const bar = document.querySelector<HTMLElement>('.progress__bar')

      // Barra de progreso de lectura.
      let ticking = false
      const update = () => {
        const max = root.scrollHeight - root.clientHeight
        bar?.style.setProperty('--progress', String(max > 0 ? root.scrollTop / max : 0))
        ticking = false
      }
      addEventListener('scroll', () => {
        if (!ticking) requestAnimationFrame(update)
        ticking = true
      }, { passive: true })
      update()

      // Entrada sutil de cada pantalla al aparecer.
      if (root.classList.contains('reveal-ready')) {
        root.dataset.revealing = 'true'
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        }, { threshold: 0.15 })
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el))
      }
    </script>
  </body>
</html>

<style is:global>
  /* Vigencia (CLAUDE.md §10): el script del <head> agrega .is-vencida si la fecha ya pasó. */
  .vencida,
  .aviso-vencida {
    display: none;
  }

  .is-vencida.is-envio main > .contenido {
    display: none;
  }

  .is-vencida.is-envio .vencida {
    display: grid;
  }

  .is-vencida .aviso-vencida {
    display: block;
  }

  :root {
    --header-h: calc(var(--space-s) * 2 + 2.75rem);
    --banner-h: 0px;
    --chrome-h: calc(var(--header-h) + var(--banner-h) + env(safe-area-inset-top));
  }

  .is-revision {
    --banner-h: 3.25rem;
  }

  @media (min-width: 40rem) {
    .is-revision {
      --banner-h: 2.25rem;
    }
  }
</style>

<style>
  .vencida {
    align-content: center;
    justify-items: start;
    gap: var(--space-m);
    min-block-size: calc(100svh - var(--chrome-h));
    max-inline-size: 40rem;
    margin-inline: auto;
    padding: var(--space-2xl) max(var(--space-m), env(safe-area-inset-right)) var(--space-2xl) max(var(--space-m), env(safe-area-inset-left));
  }

  .vencida__logo {
    inline-size: 8rem;
    block-size: auto;
    margin-block-end: var(--space-m);
  }

  .vencida__titulo {
    font-size: var(--step-4);
  }

  .vencida__boton {
    display: inline-flex;
    align-items: center;
    min-block-size: 48px;
    padding: var(--space-xs) var(--space-l);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-m);
    font-weight: var(--strong-weight);
    text-decoration: none;
  }

  .vencida__boton:hover {
    color: var(--color-on-accent);
    background: color-mix(in srgb, var(--color-accent) 88%, var(--color-text));
  }

  .aviso-vencida {
    margin: var(--space-s) max(var(--space-m), env(safe-area-inset-left));
    padding: var(--space-xs) var(--space-s);
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-s);
    inset-block-start: calc(-1 * var(--space-3xl));
    z-index: 20;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-s);
  }

  .skip-link:focus {
    inset-block-start: var(--space-s);
  }

  /* El encabezado queda fijo arriba con fondo propio: los titulares pasan por debajo, nunca encima del logo. */
  .chrome {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    padding-block-start: env(safe-area-inset-top);
    background: var(--color-bg);
  }

  .review-banner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3xs);
    block-size: var(--banner-h);
    padding-inline: max(var(--space-m), env(safe-area-inset-left)) max(var(--space-m), env(safe-area-inset-right));
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* En la franja y el encabezado las etiquetas van en ancho normal para caber en 360 px. */
  .review-banner :global(.t-label),
  .site-header :global(.t-label) {
    font-stretch: 100%;
    letter-spacing: 0.08em;
  }

  .review-banner :global(.t-label) {
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .site-header__para {
      display: none;
    }
  }

  @media (min-width: 40rem) {
    .review-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-s);
    }
  }

  .review-banner__todos summary {
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-decoration-thickness: var(--line-width);
    text-underline-offset: 0.25em;
  }

  .review-banner__todos summary::-webkit-details-marker {
    display: none;
  }

  .review-banner__todos ol {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    max-block-size: 60svh;
    overflow-y: auto;
    padding: var(--space-s) var(--space-m) var(--space-s) var(--space-xl);
    background: var(--color-surface);
    color: var(--color-text);
    border-block-end: var(--line-width) solid var(--color-line);
    font-size: var(--step--1);
  }

  .review-banner__todos li + li {
    margin-block-start: var(--space-3xs);
  }

  .review-banner__todos code {
    color: var(--color-accent);
  }

  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    block-size: var(--header-h);
    padding-inline: max(var(--space-m), env(safe-area-inset-left)) max(var(--space-m), env(safe-area-inset-right));
    border-block-end: var(--line-width) solid var(--color-line);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1;
    white-space: nowrap;
  }

  /* Nombre de plaza: mayúsculas con ancho expandido solo si tiene hasta 5 palabras. */
  .site-header__brand.is-short {
    font-weight: var(--title-short-weight);
    font-stretch: var(--title-short-stretch);
    text-transform: var(--title-short-transform);
    letter-spacing: var(--title-short-tracking);
  }

  .site-header__brand.is-long {
    font-weight: var(--title-long-weight);
    font-stretch: var(--title-long-stretch);
    letter-spacing: var(--title-long-tracking);
  }

  .site-header :global(.site-header__recipient) {
    color: var(--color-text-muted);
    text-align: end;
  }

  .progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(-1 * var(--line-width));
    block-size: calc(var(--line-width) * 2);
  }

  .progress__bar {
    display: block;
    block-size: 100%;
    background: var(--color-accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  main:focus {
    outline: none;
  }

</style>
