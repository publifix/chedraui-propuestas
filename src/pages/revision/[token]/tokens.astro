---
// Muestra de los tokens de diseño de la plaza, para revisión interna. Solo existe bajo
// el token de revisión de cada presentación y hereda noindex del layout.
import PresentationLayout from '../../../layouts/PresentationLayout.astro'
import Headline from '../../../components/Headline.astro'
import Label from '../../../components/Label.astro'
import Screen from '../../../components/Screen.astro'
import { formatAmount, formatMoney, formatPercent } from '../../../lib/calc'
import { staticPaths, type RouteEntry } from '../../../lib/site'
import { checkContrast, resolveMedidas, SPACE_STEPS, typeStep, TYPE_STEPS, type ColorName } from '../../../lib/theme'
import { MAX_UPPERCASE_WORDS } from '../../../lib/typography'

export function getStaticPaths() {
  return staticPaths('revision')
}

const { model } = Astro.props as RouteEntry['props']
const { plaza } = model
const { tema } = plaza
const medidas = resolveMedidas(tema)
const [local] = model.locales
const calc = local!.calculos
const { renta_mensual: renta, mantenimiento_mensual: mantenimiento } = local!.condiciones
const subtotal = calc.subtotalMensual.amount

const swatches: Array<{ name: ColorName; variable: string; uso: string }> = [
  { name: 'fondo', variable: '--color-bg', uso: 'Fondo de página' },
  { name: 'superficie', variable: '--color-surface', uso: 'Tarjetas, footer y texto sobre acento' },
  { name: 'texto', variable: '--color-text', uso: 'Titulares y cuerpo' },
  { name: 'texto_suave', variable: '--color-text-muted', uso: 'Texto secundario y metadatos' },
  { name: 'acento', variable: '--color-accent', uso: 'Etiquetas, progreso, foco y gráficas' },
  { name: 'acento_suave', variable: '--color-accent-soft', uso: 'Segundo tono de gráficas y rangos' },
  { name: 'linea', variable: '--color-line', uso: 'Líneas finas y separadores' },
  { name: 'marca', variable: '--color-brand', uso: 'Fondo de secciones a sangre' },
  { name: 'texto_marca', variable: '--color-on-brand', uso: 'Texto sobre el fondo de marca' },
]
const contrast = checkContrast(tema.colores)
const nombreCompleto = plaza.nombre_completo ?? plaza.nombre
const titularLargo = plaza.diferenciales[0]?.texto ?? ''
const parrafo = plaza.diferenciales.slice(0, 3).map((d) => d.texto).join(' ')
const citaMuestra = 'El lugar donde la Riviera Veracruzana ya viene a comprar, a comer y a pasear.'
const pct = (n: number) => `${(n / subtotal) * 100}%`
const px = (n: number) => `${Math.round(n * 10) / 10}px`
---
<PresentationLayout model={model} kind="revision" title={`Tokens de diseño · ${plaza.nombre}`}>
  <Screen section="TokensPaleta" labelledby="paleta" align="start">
    <Headline as="h1" id="paleta" text="Paleta y contraste" />
    <Label class="accent intro" text={`Tokens · ${plaza.nombre}`} />
    <ul class="swatches">
      {swatches.map((s) => (
        <li class="swatch">
          <span class="swatch__chip" style={`background:var(${s.variable})`}></span>
          <Label as="span" text={s.name} />
          <code class="t-meta">{tema.colores[s.name]}</code>
          <span class="t-meta">{s.uso}</span>
        </li>
      ))}
    </ul>
    <Headline class="sub" text="Pares WCAG AA" />
    <p class="t-meta">Texto: 4.5:1. Gráficas (barras y rangos): 3:1, criterio 1.4.11.</p>
    <ul class="pairs">
      {contrast.map((c) => (
        <li class="pair" style={c.tipo === 'texto' ? `background:${tema.colores[c.fondo]};color:${tema.colores[c.texto]}` : `background:${tema.colores[c.fondo]};color:${tema.colores.texto}`}>
          {c.tipo === 'texto'
            ? <span class="pair__sample">Aa</span>
            : <span class="pair__bar" style={`background:${tema.colores[c.texto]}`}></span>}
          <span>{c.texto} sobre {c.fondo}{c.tipo === 'grafica' && ' · gráfica'}</span>
          <strong class="tabular">{c.ratio.toFixed(2)}:1 · {c.pasa ? `Cumple ${c.minimo}:1` : 'No cumple'}</strong>
        </li>
      ))}
    </ul>
  </Screen>

  <Screen section="TokensTipografia" labelledby="tipografia" align="start">
    <Headline id="tipografia" text="Tipografía" />
    <Label class="accent intro" text="Archivo · Newsreader itálica" />

    <div class="roles">
      <div class="role">
        <Label class="role__name" text="Titular corto · expandido" />
        <Headline as="p" size="display" text={`Para ${model.prospecto.marca}`} />
        <Headline as="p" size="display" text={nombreCompleto} />
        <p class="t-meta">Hasta {MAX_UPPERCASE_WORDS} palabras: mayúsculas, ancho 125 %, tracking amplio. Paso más grande de la escala.</p>
      </div>

      <div class="role">
        <Label class="role__name" text="Titular largo · condensado" />
        <Headline as="p" size="display" text={titularLargo} />
        <p class="t-meta">Más de {MAX_UPPERCASE_WORDS} palabras: mayúsculas y minúsculas, ancho 70 %.</p>
      </div>

      <div class="role role--grid">
        <div>
          <Label class="role__name" text="Cuerpo y etiquetas" />
          <p class="t-body">{parrafo}</p>
          <Label class="accent sample-label" text="Renta mensual" />
          <Label class="sample-label" text="Etiqueta de más de cinco palabras pasa a minúsculas" />
        </div>
        <div>
          <Label class="role__name" text="Cifras · ancho normal" />
          <p class="t-figure">{formatAmount(calc.totalMensual.amount)}</p>
          <p class="t-meta">Total mensual IVA incluido · números tabulares</p>
          <p class="t-figure figures-stack">{formatAmount(renta)}<br />{formatAmount(mantenimiento)}<br />{formatAmount(calc.ivaMensual.amount)}</p>
        </div>
      </div>

      <figure class="role">
        <Label as="figcaption" class="role__name" text="Cita pivote · Newsreader" />
        <blockquote class="t-quote">{citaMuestra}</blockquote>
        <p class="t-meta">Único lugar con serif, siempre en mayúsculas y minúsculas. Texto de muestra.</p>
      </figure>
    </div>
  </Screen>

  <Screen section="TokensGraficas" labelledby="graficas" align="start">
    <Headline id="graficas" text="Gráficas de dos tonos" />
    <Label class="accent intro" text="Acento y acento suave" />

    <figure class="chart">
      <figcaption class="chart__title">Subtotal mensual de {local!.clave}: {formatMoney(calc.subtotalMensual)}</figcaption>
      <div class="stack" role="img" aria-label={`Renta ${formatAmount(renta)} y mantenimiento ${formatAmount(mantenimiento)}, sin IVA`}>
        <span class="stack__seg stack__seg--strong" style={`inline-size:${pct(renta)}`}>
          <span class="stack__value tabular">{formatPercent(renta / subtotal)}</span>
        </span>
        <span class="stack__seg stack__seg--soft" style={`inline-size:${pct(mantenimiento)}`}></span>
      </div>
      <ul class="legend">
        <li><span class="legend__key legend__key--strong"></span><span>Renta · <span class="tabular">{formatAmount(renta)}</span></span></li>
        <li><span class="legend__key legend__key--soft"></span><span>Mantenimiento · <span class="tabular">{formatAmount(mantenimiento)}</span></span></li>
      </ul>
    </figure>

    <figure class="chart">
      <figcaption class="chart__title">Forma de un rango con su valor actual</figcaption>
      <div class="range" role="img" aria-label="Ejemplo visual de rango, sin valores">
        <span class="range__band"></span>
        <span class="range__mark"></span>
      </div>
      <p class="t-meta">Ejemplo de forma, sin valores: el rango de costo de ocupación del giro sigue pendiente de validar.</p>
    </figure>
  </Screen>

  <Screen section="TokensSeccionClara" labelledby="seccion-clara">
    <Headline id="seccion-clara" text="Sección clara" />
    <p class="t-lead">{plaza.diferenciales[3]?.texto}</p>
    <div class="figure-row">
      <div>
        <Label text="Renta mensual" />
        <p class="t-figure">{formatAmount(renta)}</p>
        <p class="t-meta">+ IVA</p>
      </div>
      <div>
        <Label text="Área" />
        <p class="t-figure">{local!.area_m2}</p>
        <p class="t-meta">m²</p>
      </div>
    </div>
  </Screen>

  <Screen section="TokensSeccionMarca" labelledby="seccion-marca" tone="brand">
    <Headline id="seccion-marca" text="Sección de marca" />
    <p class="t-lead">{plaza.diferenciales[3]?.texto}</p>
    <div class="figure-row">
      <div>
        <Label text="Renta mensual" />
        <p class="t-figure">{formatAmount(renta)}</p>
        <p class="t-meta">+ IVA</p>
      </div>
      <div>
        <Label text="Área" />
        <p class="t-figure">{local!.area_m2}</p>
        <p class="t-meta">m²</p>
      </div>
    </div>
  </Screen>

  <Screen section="TokensEscala" labelledby="escala" align="start">
    <Headline id="escala" text="Escala tipográfica fluida" />
    <Label class="accent intro" text={`De 360 a 1280 px`} />
    <ol class="steps">
      {[...TYPE_STEPS].reverse().map((step) => {
        const { minPx, maxPx } = typeStep(step, medidas.escala)
        return (
          <li class="step">
            <code class="t-meta">step {step} · {px(minPx)} a {px(maxPx)}</code>
            <span class:list={['step__sample', step >= 1 && 'step__sample--display']} style={`font-size:var(--step-${step})`}>
              {step >= 1 ? 'Riviera' : 'Texto de cuerpo y etiquetas'}
            </span>
          </li>
        )
      })}
    </ol>
  </Screen>

  <Screen section="TokensEspacios" labelledby="espacios" align="start">
    <Headline id="espacios" text="Espacios, línea y tarjeta" />
    <Label class="accent intro" text={`Base ${medidas.espacio_base} px`} />
    <ul class="spaces">
      {Object.entries(SPACE_STEPS).map(([name, factor]) => (
        <li class="space">
          <code class="t-meta">space {name} · {px(medidas.espacio_base * factor)}</code>
          <span class="space__bar" style={`inline-size:var(--space-${name})`}></span>
        </li>
      ))}
    </ul>
    <p class="t-meta">Radio {medidas.radio} px · línea {medidas.linea} px · movimiento {medidas.duracion_ms} ms</p>
    <hr class="rule" />
    <article class="card" aria-labelledby="tarjeta">
      <Label id="tarjeta" text={`Tarjeta · ${local!.clave}`} />
      <dl class="card__rows">
        <div><dt>Renta mensual</dt><dd>{formatAmount(renta)} + IVA</dd></div>
        <div><dt>Mantenimiento</dt><dd>{formatAmount(mantenimiento)} + IVA</dd></div>
        <div><dt>IVA</dt><dd>{formatMoney(calc.ivaMensual)}</dd></div>
        <div class="card__total"><dt>Total mensual</dt><dd class="t-figure">{formatAmount(calc.totalMensual.amount)}</dd></div>
      </dl>
      <p class="t-meta">Montos calculados con src/lib/calc desde las condiciones del local.</p>
    </article>
  </Screen>
</PresentationLayout>

<style>
  /* Clases que reciben componentes hijos (Headline, Label): se declaran globales dentro de la página. */
  :global(.accent) {
    color: var(--color-accent);
  }

  :global(.intro) {
    margin-block: var(--space-xs) var(--space-xl);
  }

  :global(.sub) {
    margin-block: var(--space-2xl) var(--space-2xs);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-l) var(--space-m);
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: grid;
    gap: var(--space-3xs);
  }

  .swatch__chip {
    block-size: 5rem;
    margin-block-end: var(--space-2xs);
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
  }

  .pairs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-s);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .pair {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    font-size: var(--step--1);
  }

  .pair__sample {
    font-family: var(--font-display);
    font-weight: var(--title-long-weight);
    font-size: var(--step-3);
    line-height: 1;
  }

  .pair__bar {
    display: block;
    block-size: var(--space-s);
    margin-block: var(--space-2xs);
    border-radius: var(--radius-s);
  }

  .roles {
    display: grid;
    gap: var(--space-2xl);
  }

  .role {
    display: grid;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: var(--line-width) solid var(--color-line);
  }

  .role :global(.role__name) {
    color: var(--color-text-muted);
  }

  .role--grid {
    gap: var(--space-xl);
  }

  .role--grid > div {
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .role :global(.sample-label) {
    margin-block-start: var(--space-2xs);
  }

  .figures-stack {
    margin-block-start: var(--space-s);
    font-size: calc(var(--step-3) * var(--figure-size));
    line-height: 1.15;
    text-align: end;
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .role--grid {
      grid-template-columns: 3fr 2fr;
    }
  }

  .chart {
    display: grid;
    gap: var(--space-s);
    max-inline-size: 40rem;
    margin-block-end: var(--space-2xl);
  }

  .chart__title {
    font-weight: var(--strong-weight);
  }

  .stack,
  .range {
    position: relative;
    display: flex;
    block-size: var(--space-xl);
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }

  .stack__seg {
    display: flex;
    align-items: center;
    padding-inline: var(--space-xs);
  }

  .stack__seg--strong {
    background: var(--color-accent);
  }

  .stack__seg--soft {
    background: var(--color-accent-soft);
  }

  .stack__value {
    color: var(--color-surface);
    font-size: var(--step--1);
    font-weight: var(--strong-weight);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .legend__key {
    inline-size: var(--space-s);
    block-size: var(--space-s);
    border-radius: var(--radius-s);
  }

  .legend__key--strong {
    background: var(--color-accent);
  }

  .legend__key--soft {
    background: var(--color-accent-soft);
  }

  .range {
    border: var(--line-width) solid var(--color-line);
  }

  .range__band {
    position: absolute;
    inset-block: 0;
    inset-inline: 30% 25%;
    background: var(--color-accent-soft);
  }

  .range__mark {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 58%;
    inline-size: calc(var(--line-width) * 3);
    background: var(--color-accent);
  }

  .figure-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl) var(--space-2xl);
    margin-block-start: var(--space-xl);
  }

  .figure-row .t-meta {
    margin-block-start: var(--space-3xs);
  }

  .t-lead {
    margin-block-start: var(--space-m);
  }

  .steps,
  .spaces {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: var(--space-3xs);
    padding-block-end: var(--space-s);
    border-block-end: var(--line-width) solid var(--color-line);
  }

  .step__sample {
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .step__sample--display {
    font-family: var(--font-display);
    font-weight: var(--title-short-weight);
    font-stretch: var(--title-short-stretch);
    text-transform: var(--title-short-transform);
    letter-spacing: var(--title-short-tracking);
  }

  .space {
    display: grid;
    grid-template-columns: minmax(0, 12rem) 1fr;
    align-items: center;
    gap: var(--space-s);
  }

  .space__bar {
    block-size: var(--space-s);
    background: var(--color-accent);
    border-radius: var(--radius-s);
  }

  .spaces + .t-meta {
    margin-block-start: var(--space-m);
  }

  .rule {
    margin-block: var(--space-2xl);
  }

  .card {
    display: grid;
    gap: var(--space-m);
    max-inline-size: 28rem;
    padding: var(--space-l);
    background: var(--color-surface);
    border: var(--line-width) solid var(--color-line);
    border-radius: var(--radius-m);
    box-shadow: 0 var(--space-3xs) var(--space-l) color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .card__rows {
    display: grid;
  }

  .card__rows div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: var(--line-width) solid var(--color-line);
  }

  .card__rows dt {
    color: var(--color-text-muted);
  }

  /* Montos de la tarjeta de condiciones con números tabulares. */
  .card__rows dd {
    font-variant-numeric: lining-nums tabular-nums;
  }

  .card__total {
    border-block-end: 0 !important;
    padding-block-start: var(--space-s) !important;
  }

  .card__total dt {
    color: var(--color-text);
  }

  .card__total .t-figure {
    font-size: calc(var(--step-3) * var(--figure-size));
  }
</style>
