---
// Link de envío: solo existe para presentaciones en estado "lista". El tracking llega en el paso 9.
import PresentationLayout from '../../layouts/PresentationLayout.astro'
import Sections from '../../components/sections/Sections.astro'
import { staticPaths, type RouteEntry } from '../../lib/site'

export function getStaticPaths() {
  return staticPaths('envio')
}

const { model, route } = Astro.props as RouteEntry['props']
---
<PresentationLayout model={model} kind="envio" route={route}>
  <Sections model={model} kind="envio" />
</PresentationLayout>
