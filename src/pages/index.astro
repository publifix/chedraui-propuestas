---
// Portada neutra del sitio: confirma el deploy y no lista ni enlaza presentaciones.
import Headline from '../components/Headline.astro'
import PublifixLayout from '../layouts/PublifixLayout.astro'

const builtAt = new Date().toISOString()
---
<PublifixLayout title="Publifix">
  <Headline as="h1" size="display" text="Presentaciones comerciales" />
  <p class="t-lead">Las propuestas se comparten solo mediante su liga directa.</p>
  <p class="t-meta">Build: <time datetime={builtAt}>{builtAt}</time></p>
</PublifixLayout>
